{
  "name": "AvatarCatalog",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del avatar"
    },
    "url": {
      "type": "string",
      "description": "URL de la imagen del avatar generada por IA"
    }
  },
  "required": [
    "name",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}