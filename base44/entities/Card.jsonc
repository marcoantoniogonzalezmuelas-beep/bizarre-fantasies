{
  "name": "Card",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique card identifier"
    },
    "number": {
      "type": "number",
      "description": "Card number in the set"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Subtitle/epithet"
    },
    "category": {
      "type": "string",
      "enum": [
        "hero",
        "bizarro",
        "spell",
        "ranged_weapon",
        "melee_weapon",
        "armor",
        "object",
        "bonus",
        "race"
      ]
    },
    "clan": {
      "type": "string",
      "description": "Race/faction"
    },
    "clan_color": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "CC/AD/HE for heroes, element for spells, etc."
    },
    "cost": {
      "type": "number"
    },
    "cc": {
      "type": "number"
    },
    "ad": {
      "type": "number"
    },
    "he": {
      "type": "number"
    },
    "hp": {
      "type": "number"
    },
    "mana": {
      "type": "number"
    },
    "power": {
      "type": "number"
    },
    "velocidad": {
      "type": "number",
      "description": "Velocidad base del h\u00e9roe (iniciativa de turno). Refleja el stat primario (CC\u2192cc, AD\u2192ad, HE\u2192he) y es editable desde el backoffice."
    },
    "ability_name": {
      "type": "string"
    },
    "ability_text": {
      "type": "string"
    },
    "elite_ability_name": {
      "type": "string"
    },
    "elite_ability_text": {
      "type": "string"
    },
    "elite_cc": {
      "type": "number"
    },
    "elite_ad": {
      "type": "number"
    },
    "elite_he": {
      "type": "number"
    },
    "elite_hp": {
      "type": "number"
    },
    "elite_velocidad": {
      "type": "number",
      "description": "Velocidad de la versi\u00f3n \u00e9lite del h\u00e9roe (iniciativa de turno)."
    },
    "tag": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "en": {
      "type": "object",
      "description": "English translations of the card texts",
      "properties": {
        "name": {
          "type": "string",
          "description": "English name (equipment/booster cards; heroes keep their proper name)"
        },
        "title": {
          "type": "string"
        },
        "ability_name": {
          "type": "string"
        },
        "ability_text": {
          "type": "string"
        },
        "elite_ability_name": {
          "type": "string"
        },
        "elite_ability_text": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "art_url": {
      "type": "string",
      "description": "URL of the generated art"
    },
    "elite_art_url": {
      "type": "string",
      "description": "URL of elite version art"
    },
    "battle_art_url": {
      "type": "string",
      "description": "URL of the AI-generated battle scene art (base version in combat)"
    },
    "elite_battle_art_url": {
      "type": "string",
      "description": "URL of the AI-generated elite battle scene art (elite version in combat)"
    },
    "ability_anim_url": {
      "type": "string",
      "description": "URL of the AI-generated 3D cinematic art for the normal ability animation"
    },
    "ability_anim_desc": {
      "type": "string",
      "description": "Description/prompt used to generate the 3D cinematic animation of the normal ability"
    },
    "ability_anim_motion": {
      "type": "string",
      "description": "Movimiento en pantalla de la cinem\u00e1tica 3D normal (auto, fly, spin, headbutt, roam, tornado, teleport, heroic, slash\u2026). 'auto' = elegido por palabras clave de la descripci\u00f3n."
    },
    "elite_ability_anim_url": {
      "type": "string",
      "description": "URL of the AI-generated 3D cinematic art for the elite ability animation"
    },
    "elite_ability_anim_desc": {
      "type": "string",
      "description": "Description/prompt used to generate the 3D cinematic animation of the elite ability"
    },
    "elite_ability_anim_motion": {
      "type": "string",
      "description": "Movimiento en pantalla de la cinem\u00e1tica 3D \u00e9lite. 'auto' = elegido por palabras clave de la descripci\u00f3n."
    },
    "passive_marker": {
      "type": "object",
      "description": "Marcador de habilidad pasiva en batalla. Se muestra sobre el retrato cuando el flag est\u00e1 activo.",
      "properties": {
        "flag": {
          "type": "string",
          "description": "Flag del estado pasivo en el juego (ej: _bfRefract)"
        },
        "icon": {
          "type": "string",
          "description": "Icono/emoji del marcador"
        },
        "color": {
          "type": "string",
          "description": "Color del marcador (hex)"
        },
        "label": {
          "type": "string",
          "description": "Texto del marcador"
        }
      }
    },
    "in_auction": {
      "type": "boolean",
      "description": "If true, the hero is available in auctions"
    },
    "foil": {
      "type": "boolean",
      "description": "If true, the card has a holographic foil effect"
    },
    "gold_border": {
      "type": "boolean",
      "description": "If true, the card has a thick golden border (premium style)"
    },
    "rainbow_border": {
      "type": "boolean",
      "description": "If true, the card has a thick animated multicolor (rainbow) border"
    }
  },
  "required": [
    "name",
    "category"
  ]
}