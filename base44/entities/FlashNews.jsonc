{
  "name": "FlashNews",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "Texto de la noticia que aparece en el cartel digital de la home"
    },
    "text_en": {
      "type": "string",
      "description": "Traducci\u00f3n al ingl\u00e9s del texto (opcional; si no se rellena, se usa el texto en espa\u00f1ol)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si true, la noticia se muestra en el cartel"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n (menor primero)"
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}