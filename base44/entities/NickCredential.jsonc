{
  "name": "NickCredential",
  "type": "object",
  "properties": {
    "nick": {
      "type": "string",
      "description": "Nick del jugador en min\u00fasculas (clave \u00fanica l\u00f3gica)"
    },
    "password": {
      "type": "string",
      "description": "Hash salado PBKDF2 (pbkdf2$salt$hash) de la contrase\u00f1a que protege el nick. Solo accesible desde la funci\u00f3n nickAuth."
    },
    "fail_count": {
      "type": "number",
      "default": 0,
      "description": "Intentos fallidos consecutivos de contrase\u00f1a (bloqueo persistente contra fuerza bruta)"
    },
    "locked_until": {
      "type": "number",
      "default": 0,
      "description": "Marca de tiempo (ms) hasta la que el nick est\u00e1 bloqueado por intentos fallidos"
    }
  },
  "required": [
    "nick",
    "password"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}