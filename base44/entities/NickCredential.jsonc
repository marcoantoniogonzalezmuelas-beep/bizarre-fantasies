{
  "name": "NickCredential",
  "type": "object",
  "properties": {
    "nick": {
      "type": "string",
      "description": "Nick del jugador en min\u00fasculas (clave \u00fanica l\u00f3gica)"
    },
    "password": {
      "type": "string",
      "description": "Hash SHA-256 de la contrase\u00f1a que protege el nick"
    }
  },
  "required": [
    "nick",
    "password"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}