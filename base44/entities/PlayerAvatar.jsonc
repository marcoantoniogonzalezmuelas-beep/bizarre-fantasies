{
  "name": "PlayerAvatar",
  "type": "object",
  "properties": {
    "nick": {
      "type": "string",
      "description": "Nick del jugador"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL del avatar (foto subida por el jugador, recortada a c\u00edrculo)"
    }
  },
  "required": [
    "nick",
    "avatar_url"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
