{
  "name": "GameRoom",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished",
        "resuming"
      ],
      "default": "waiting"
    },
    "host_name": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "left_at": {
      "type": "number",
      "description": "Timestamp (ms) en el que un jugador sali\u00f3 de la partida en curso."
    },
    "state": {
      "type": "object"
    }
  },
  "required": [
    "room_code",
    "state"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}