{
  "name": "GameRoom",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished",
        "resuming"
      ],
      "default": "waiting"
    },
    "host_name": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "state": {
      "type": "object"
    }
  },
  "required": [
    "room_code",
    "state"
  ]
}