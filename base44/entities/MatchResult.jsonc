{
  "name": "MatchResult",
  "type": "object",
  "properties": {
    "winner_nick": {
      "type": "string"
    },
    "loser_nick": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "online",
        "local",
        "ia"
      ]
    },
    "ai_level": {
      "type": "string",
      "description": "ID del nivel de IA derrotado (novice, berserker, strategist, nemesis) cuando mode=ia"
    },
    "winner_is_ai": {
      "type": "boolean",
      "default": false
    },
    "loser_is_ai": {
      "type": "boolean",
      "default": false
    },
    "winner_avatar": {
      "type": "string",
      "description": "URL del avatar del ganador (para mostrar en el ranking)"
    },
    "loser_avatar": {
      "type": "string",
      "description": "URL del avatar del perdedor (para mostrar en el ranking)"
    },
    "winner_heroes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "died": {
            "type": "boolean"
          },
          "elite": {
            "type": "boolean"
          }
        }
      }
    },
    "loser_heroes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "died": {
            "type": "boolean"
          },
          "elite": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "winner_nick",
    "loser_nick"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}